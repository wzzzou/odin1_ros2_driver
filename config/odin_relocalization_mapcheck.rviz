Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: map_grid
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/TF
          Enabled: true
          Frame Timeout: 15
          Marker Scale: 0.8
          Name: tf_frames_map_odom_odin
          Show Arrows: true
          Show Axes: true
          Show Names: false
          Update Interval: 0
          Value: true
        - Class: rviz_default_plugins/Odometry
          Enabled: true
          Keep: 1
          Name: odom_pose_current
          Shape:
            Axes Length: 1.0
            Axes Radius: 0.08
            Value: Axes
          Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /odin1/odometry
          Value: true
        - Class: rviz_default_plugins/MarkerArray
          Enabled: false
          Name: odom_path_after_relocalization
          Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /odin1/path
          Value: false
      Enabled: true
      Name: Relocalization State
      Value: true
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/PointCloud2
          Alpha: 0.18
          Color: 180; 220; 255
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: map_cloud_reference
          Position Transformer: XYZ
          Size (Pixels): 1
          Size (m): 0.03
          Style: Points
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            Filter size: 1
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /odin1/map_cloud
          Use Fixed Frame: true
          Value: true
        - Class: rviz_default_plugins/PointCloud2
          Alpha: 0.65
          Channel Name: rgb
          Color Transformer: RGB8
          Decay Time: 0
          Enabled: false
          Name: map_cloud_local
          Position Transformer: XYZ
          Size (Pixels): 2
          Size (m): 0.015
          Style: Points
          Topic:
            Depth: 1
            Durability Policy: Volatile
            Filter size: 1
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /odin1/map_cloud_local
          Use Fixed Frame: true
          Value: false
        - Class: rviz_default_plugins/PointCloud2
          Alpha: 1
          Channel Name: rgb
          Color Transformer: RGB8
          Decay Time: 0
          Enabled: true
          Name: slam_current
          Position Transformer: XYZ
          Size (Pixels): 3
          Size (m): 0.01
          Style: Points
          Topic:
            Depth: 1
            Durability Policy: Volatile
            Filter size: 1
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /odin1/cloud_slam
          Use Fixed Frame: true
          Value: true
        - Class: rviz_default_plugins/PointCloud2
          Alpha: 0.18
          Channel Name: rgb
          Color Transformer: RGB8
          Decay Time: 30
          Enabled: false
          Name: slam_recent_30s
          Position Transformer: XYZ
          Size (Pixels): 1
          Size (m): 0.006
          Style: Points
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 8
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /odin1/cloud_slam
          Use Fixed Frame: true
          Value: false
      Enabled: true
      Name: Map Check
      Value: true
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/Image
          Enabled: false
          Max Value: 1
          Median window: 5
          Min Value: 0
          Name: camera_image
          Normalize Range: true
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /odin1/image
          Value: false
      Enabled: true
      Name: Camera
      Value: true
  Enabled: true
  Global Options:
    Background Color: 30; 30; 36
    Fixed Frame: map
    Frame Rate: 10
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 18
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 1.1
      Target Frame: <Fixed Frame>
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
